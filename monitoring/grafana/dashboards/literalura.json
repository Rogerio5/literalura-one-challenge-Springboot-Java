      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_sum{job=\"literalura-api\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"literalura-api\"}[5m])), 0.000001)) * 1000",
